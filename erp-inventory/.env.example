# Copiez ce fichier vers .env.local et renseignez les valeurs réelles.
# Ne jamais committer .env.local (ignoré par git).

NODE_ENV=development

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require

# Session & accès (obligatoires en production)
SESSION_SECRET=remplacez-par-une-chaine-aleatoire-de-32-caracteres-minimum
ADMIN_PIN=1234

# Cloudflare R2 (média)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
